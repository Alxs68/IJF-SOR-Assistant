      "llm": false
    },
    {
      "id": "E11A-3",
      "desc": "Diagnostico de recuperacion R0 vs R1, DICT vs LLM",
      "cmd": "python scripts/diag_retrieval_f11.py --llm-results data/eval/fase11/llm_dev_f11.json",
      "where": "Windows",
      "llm": false
    },
    {
      "id": "E11A-4",
      "desc": "Recalculo offline estricto vs equivalente",
      "cmd": "python scripts/recompute_equivalence_f11.py",
      "llm": false
    },
    {
      "id": "E11A-5",
      "desc": "CSV arbitral y diagnostico de abstenciones",
      "cmd": "python scripts/diag_abstentions_f11.py --dev data/eval/fase11/llm_dev_f11_rescored.json --phase10 data/eval/benchmark_v2/results/llm_shadow_dev_rescored.json data/eval/benchmark_v2/results/llm_shadow_test_sealed_rescored.json",
      "llm": false
    },
    {
      "id": "E11A-6",
      "desc": "Captura exacta de entradas del DIG (2 corridas dev; degradada por cuota: 20 llamadas DIG)",
      "cmd": "python scripts/eval_llm_shadow.py --split dev --runs 2 --sleep 8 --capture-dig --out data/eval/fase11/llm_dev_f11_capture.json",
      "where": "Windows",
      "llm": true
    },
    {
      "id": "E11A-7",
      "desc": "Reejecucion offline DIG base y variante DIG-06 + 130 ataques adversariales",
      "cmd": "python scripts/replay_dig_f11.py data/eval/fase11/llm_dev_f11_capture.json data/eval/fase11/llm_dev_f11_rescored.json",
      "llm": false,
      "params": {
        "variant": "experimental.dig_variants.numbers_in_v2 (dashes Unicode, edicion de corpus_config, listas 1..k, etiqueta+titulo propio)",
        "attacks": [
          "A1",
          "A2",
          "A3",
          "A4",
          "A4b",
          "A5",
          "A6"
        ]
      }
    },
    {
      "id": "E11B-1",
      "desc": "Variantes de recuperacion R2,R3,R4,R5 por separado frente a R0 (dev)",
      "cmd": "python scripts/eval_f11_retrieval.py --llm-results data/eval/fase11/llm_dev_f11.json",
      "where": "Windows",
      "llm": false,
      "params": {
        "R0": "rre.retrieve(top_k=25, expand_graph=True)",
        "RRF_k": 60,
        "fusion_weights": "1:1",
        "R3_beta": [
          0.2,
          0.5
        ],
        "R3_indicators": "share>=0.5, lift>=4, count>=3 sobre titulos de partes COVER",
        "R4_max_lane": 3,
        "R5_model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
        "R5_max_seq": 256
      }
    },
    {
      "id": "E11C-1",
      "desc": "Resumen del flujo completo de base (Fase 10 dev reclasificado con equivalencia) y Fase 11",
      "cmd": "python scripts/eval_llm_shadow.py --rescore data/eval/fase11/llm_dev_f10_baseline.json (+ agregacion en e2e_dev_summary.json)",
      "llm": false
    }
  ],
