# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
venv/
ENV/
env/

# Secrets and Configs
.env
*.key
*.pem
*.pub

# Local generated index caches (RAG engine compiles these on-the-fly)
scratch/*.json
scratch/*.metadata.json
scratch/*.csv

# Streamlit logs and configurations
.streamlit/
*.log
nohup.out

# Legacy index compressed backup
archive/

# User feedback dynamic observations (privacy)
data/feedback/*.jsonl

# Unprocessed raw pages from historical rebuild
data/processed/rebuild_2026_08/pages_raw/

# Temporary visual captures from Playwright browser scripts
scratch/*.png
scratch/*.jpg

